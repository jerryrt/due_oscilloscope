/*
 * FW_GIT_REV - the commit this image was built from.
 *
 * GENERATED by cmake/fw_git_rev.cmake before every firmware build, into
 * the build tree. Do not edit, and do not check it in: it tracks HEAD
 * and the working tree, which is the property a configure-time value
 * does not have.
 *
 *   a905380            a clean tree
 *   a905380+1f2e3d4a   dirty - the commit, then the first eight hex
 *                      characters of the working-tree delta hash that
 *                      tools/flash.py logs as `dirty_sha`, so the board
 *                      and the flash log name one dirty state alike
 *   unknown            git could not answer: no git, or no work tree
 *
 * The bound is ctl_wire.h's `build[24]` - 23 characters and a NUL. The
 * dirty form is 16 with a seven-character abbreviation, and git
 * lengthens an abbreviation only to disambiguate, so it would have to
 * reach fourteen before the bound bites. The generator fails the build
 * rather than truncating; the assertion below catches a hand-edited
 * header.
 */

#ifndef FW_GIT_REV_H
#define FW_GIT_REV_H

#define FW_GIT_REV "@FW_GIT_REV@"

#ifdef __cplusplus
static_assert(sizeof(FW_GIT_REV) <= 24,
              "FW_GIT_REV must fit ctl_wire.h's build[24]");
#else
_Static_assert(sizeof(FW_GIT_REV) <= 24,
               "FW_GIT_REV must fit ctl_wire.h's build[24]");
#endif

#endif /* FW_GIT_REV_H */
