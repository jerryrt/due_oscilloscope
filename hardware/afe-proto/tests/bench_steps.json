{
  "_doc": "Steps the bench runs and budgets. {board} expands to each file under 'boards'. Paths are relative to the repository root (/work in the image). A step is added here when a tool exists; the old per-board tools (build_pcb, lr_check, check, ...) are added by the people who own them, with their argv.",
  "boards": {
    "v1": "hardware/afe-proto/tests/fixtures/v1-34b2e51/kicad/afe-proto.kicad_pcb",
    "v2-BASE": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-BASE-056e1d03.kicad_pcb",
    "v2-awg": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-awg-bc96e334.kicad_pcb",
    "v2-integrated": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-integrated-990d4b03.kicad_pcb",
    "v2-power": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-power-a5605a04.kicad_pcb",
    "v2-power3": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-power3-7c838703.kicad_pcb",
    "v2-refcal": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-refcal-326f141b.kicad_pcb",
    "v2-scope2east": "hardware/afe-proto/tests/fixtures/v2-8a1f7ac/v2-scope2east-05ee441f.kicad_pcb"
  },
  "per_board": [
    {
      "tool": "pcbnew-load",
      "argv": [
        "python3",
        "-c",
        "import pcbnew,sys; pcbnew.LoadBoard(sys.argv[1])",
        "{board}"
      ]
    },
    {
      "tool": "boardio-read",
      "argv": [
        "python3",
        "-c",
        "import sys; sys.path.insert(0,'hardware/afe-proto'); from pcbtools import boardio; boardio.read_board(sys.argv[1])",
        "{board}"
      ]
    },
    {
      "tool": "kicad-cli-step",
      "argv": [
        "kicad-cli",
        "pcb",
        "export",
        "step",
        "-o",
        "/tmp/bench.step",
        "{board}"
      ]
    },
    {
      "tool": "kicad-cli-render",
      "argv": [
        "kicad-cli",
        "pcb",
        "render",
        "-o",
        "/tmp/bench.png",
        "{board}"
      ]
    },
    {
      "tool": "sexpr-parse",
      "argv": [
        "python3",
        "hardware/afe-proto/tests/pcbtools/bench_tools.py",
        "sexpr",
        "{board}"
      ]
    },
    {
      "tool": "editor-roundtrip",
      "argv": [
        "python3",
        "hardware/afe-proto/tests/pcbtools/bench_tools.py",
        "editor",
        "{board}"
      ]
    }
  ],
  "global": [
    {
      "tool": "erc-v1-schematic",
      "board": "v1",
      "argv": [
        "kicad-cli",
        "sch",
        "erc",
        "--format",
        "json",
        "-o",
        "/tmp/bench-erc.json",
        "hardware/afe-proto/tests/fixtures/v1-34b2e51/kicad/afe-proto.kicad_sch"
      ]
    },
    {
      "tool": "ngspice-rc-ladder",
      "board": "-",
      "argv": [
        "python3",
        "hardware/afe-proto/tests/bench_ngspice.py"
      ]
    },
    {
      "tool": "netlib-text-v1v2",
      "board": "v1+v2",
      "argv": [
        "python3",
        "-I",
        "-c",
        "import sys; sys.path.insert(0,'hardware/afe-proto/tests'); import netlib_snapshot as s; s.v1_text(); s.v2_text()"
      ]
    },
    {
      "tool": "old-v1-build_pcb",
      "board": "v1",
      "argv": [
        "bash",
        "hardware/afe-proto/tests/golden/v1-34b2e51-image/run_old.sh",
        "build_pcb",
        "/tmp/bench-old"
      ]
    },
    {
      "tool": "old-v1-check-pcb",
      "board": "v1",
      "argv": [
        "bash",
        "hardware/afe-proto/tests/golden/v1-34b2e51-image/run_old.sh",
        "check_pcb",
        "/tmp/bench-old"
      ]
    },
    {
      "tool": "old-v1-lr_check",
      "board": "v1",
      "argv": [
        "bash",
        "hardware/afe-proto/tests/golden/v1-34b2e51-image/run_old.sh",
        "lr_check",
        "/tmp/bench-old"
      ]
    },
    {
      "tool": "old-v1-lr_check-mutate",
      "board": "v1",
      "argv": [
        "bash",
        "hardware/afe-proto/tests/golden/v1-34b2e51-image/run_old.sh",
        "lr_check_mutate",
        "/tmp/bench-old"
      ]
    },
    {
      "tool": "old-v1-fence_check",
      "board": "v1",
      "argv": [
        "bash",
        "hardware/afe-proto/tests/golden/v1-34b2e51-image/run_old.sh",
        "fence_check",
        "/tmp/bench-old"
      ]
    }
  ]
}
