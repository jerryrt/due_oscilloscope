    {
      "tool": "pcbnew-load",
      "argv": [
        "python3",
        "-c",
        "import pcbnew,sys; pcbnew.LoadBoard(sys.argv[1])",
        "{board}"
      ]
    },
    {
      "tool": "boardio-read",
      "argv": [
        "python3",
        "-c",
        "import sys; sys.path.insert(0,'hardware/afe-proto'); from pcbtools import boardio; boardio.read_board(sys.argv[1])",
        "{board}"
      ]
    },
    {
      "tool": "kicad-cli-step",
      "argv": [
        "kicad-cli",
        "pcb",
        "export",
        "step",
        "-o",
        "/tmp/bench.step",
        "{board}"
      ]
    },
    {
      "tool": "kicad-cli-render",
      "argv": [
        "kicad-cli",
        "pcb",
        "render",
        "-o",
        "/tmp/bench.png",
        "{board}"
      ]
    },
    {
