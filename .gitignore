# Build output
build/
build-*/
build-sketch/
*.o
*.a
*.elf
*.bin
*.hex
*.map
*.lst
*.su

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# arduino-cli
sketches/**/build/
*.ino.bin
*.ino.elf
*.ino.map

# Vendored toolchains / SDKs (fetched, not committed)
tools/toolchain/
tools/arm-gnu-toolchain-*/
tools/xpack-*/

# Host tooling
__pycache__/
*.pyc
.venv/
venv/

# Captures and scratch data
captures/
*.npy
*.raw

# macOS
.DS_Store
.venv-gui/
.venv-ft/

# Per-machine tool locations (the shared registry is toolchains.json)
toolchains.local.json

# Calibration output. Written by --calibrate for a human to promote
# into baseline.json, never to be committed as it is.
tests/baseline.measured.json

# Phase 0 summaries. Derived from the .jsonl records beside them by
# `tools/phase0.py --report`, and a derived file in the tree is a second
# home for a number that already has one.
records/*.summary.json

# A bench declares its own cabling; see host/provenance.py. One desk,
# not the repository.
bench.json

# The flash log is one desk's history of what it put on its board.
records/flash-log.jsonl
build-c/
records/issue35-reflash-transcripts.log

# Agent worktrees: transient copies of the whole tree. Source-scanning
# guards (tests/test_clean_build.py) otherwise see one "second build path"
# per live agent.
.claude/worktrees/
